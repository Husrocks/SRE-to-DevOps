{
  "name": "devops-forge-learning-lab",
  "version": "1.0.0",
  "description": "An interactive hands-on DevOps learning project and cloud-native laboratory",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/server.test.js",
    "docker:build": "docker build -t devops-forge:latest .",
    "docker:run": "docker run -p 3000:3000 --name devops-forge-app devops-forge:latest",
    "compose:up": "docker-compose up -d --build",
    "compose:down": "docker-compose down"
  },
  "keywords": [
    "devops",
    "docker",
    "kubernetes",
    "ci-cd",
    "prometheus",
    "terraform"
  ],
  "author": "DevOps Learner",
  "license": "MIT"
}
